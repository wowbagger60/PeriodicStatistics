{
    "elements": [
        {
            "type": "NumberSpinner",
            "name": "RefreshInterval",
            "caption": "Refresh interval for time-weighted averages and integrals",
            "suffix": " min",
            "minimum": 0
        },
        {
            "type": "List",
            "name": "Variables",
            "caption": "Variables",
            "rowCount": 10,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "name": "Variable",
                    "caption": "Variable",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectVariable"
                    }
                },
                {
                    "name": "Min",
                    "caption": "Min.",
                    "width": "100px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "name": "Max",
                    "caption": "Max.",
                    "width": "100px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "name": "AvgArithmetic",
                    "caption": "Avg. arithmetic",
                    "width": "150px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "name": "AvgTimeWeighted",
                    "caption": "Avg. time-weighted",
                    "width": "170px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "name": "Delta",
                    "caption": "Difference",
                    "width": "120px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "name": "Integral",
                    "caption": "Integral",
                    "width": "110px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "name": "Timestamps",
                    "caption": "Timestamps",
                    "width": "130px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                }
            ],
            "form": [
                {
                    "type": "SelectVariable",
                    "name": "Variable",
                    "caption": "Variable"
                },
                {
                    "type": "Label",
                    "caption": "All values are always calculated and stored in the JSON variable. Select which values are additionally created as individual variables:"
                },
                {
                    "type": "CheckBox",
                    "name": "Min",
                    "caption": "Minimum"
                },
                {
                    "type": "CheckBox",
                    "name": "Max",
                    "caption": "Maximum"
                },
                {
                    "type": "CheckBox",
                    "name": "AvgArithmetic",
                    "caption": "Average (arithmetic)"
                },
                {
                    "type": "CheckBox",
                    "name": "AvgTimeWeighted",
                    "caption": "Average (time-weighted)"
                },
                {
                    "type": "CheckBox",
                    "name": "Delta",
                    "caption": "Difference"
                },
                {
                    "type": "CheckBox",
                    "name": "Integral",
                    "caption": "Integral"
                },
                {
                    "type": "CheckBox",
                    "name": "Timestamps",
                    "caption": "Times of minimum and maximum"
                }
            ]
        },
        {
            "type": "List",
            "name": "TimeWindows",
            "caption": "Time windows",
            "rowCount": 8,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "name": "ID",
                    "caption": "ID",
                    "width": "0px",
                    "visible": false,
                    "add": "",
                    "save": true
                },
                {
                    "name": "Name",
                    "caption": "Name",
                    "width": "190px",
                    "add": "Custom",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "name": "Start",
                    "caption": "Start date",
                    "width": "160px",
                    "add": {
                        "day": 0,
                        "month": 0,
                        "year": 0
                    },
                    "edit": {
                        "type": "SelectDate"
                    }
                },
                {
                    "name": "Duration",
                    "caption": "Duration",
                    "width": "100px",
                    "add": 1,
                    "edit": {
                        "type": "NumberSpinner",
                        "minimum": 1
                    }
                },
                {
                    "name": "Unit",
                    "caption": "Unit",
                    "width": "120px",
                    "add": "year",
                    "edit": {
                        "type": "Select",
                        "options": [
                            {
                                "caption": "Day(s)",
                                "value": "day"
                            },
                            {
                                "caption": "Week(s)",
                                "value": "week"
                            },
                            {
                                "caption": "Month(s)",
                                "value": "month"
                            },
                            {
                                "caption": "Year(s)",
                                "value": "year"
                            }
                        ]
                    }
                },
                {
                    "name": "Repeat",
                    "caption": "Repeat",
                    "width": "100px",
                    "add": true,
                    "edit": {
                        "type": "CheckBox"
                    }
                },
                {
                    "name": "Individual",
                    "caption": "Individual variables",
                    "width": "160px",
                    "add": false,
                    "edit": {
                        "type": "CheckBox"
                    }
                }
            ]
        },
        {
            "type": "Label",
            "caption": "Deleting a time window permanently removes its statistics and individual variables. A deleted default window can be recreated with the same settings at any time, but starts empty."
        },
        {
            "type": "CheckBox",
            "name": "IndividualAlltime",
            "caption": "Individual variables for Alltime"
        },
        {
            "type": "Label",
            "name": "IndividualCount",
            "caption": "Individual variables currently created: %d"
        }
    ],
    "actions": [
        {
            "type": "Select",
            "name": "RebuildVariable",
            "caption": "Variable",
            "value": 0,
            "options": []
        },
        {
            "type": "Button",
            "caption": "Rebuild from archive",
            "confirm": "The statistics of the selected variables are replaced by values calculated from the archive. Continue?",
            "onClick": "IPS_RequestAction($id, 'Rebuild', $RebuildVariable);"
        },
        {
            "type": "PopupAlert",
            "name": "RebuildResult",
            "visible": false,
            "popup": {
                "items": [
                    {
                        "type": "Label",
                        "name": "RebuildResultText",
                        "caption": ""
                    }
                ]
            }
        },
        {
            "type": "List",
            "name": "Jobs",
            "caption": "Archive jobs (completed jobs are removed after one hour)",
            "rowCount": 5,
            "add": false,
            "delete": false,
            "columns": [
                {
                    "name": "Variable",
                    "caption": "Variable",
                    "width": "auto"
                },
                {
                    "name": "Status",
                    "caption": "Status",
                    "width": "120px"
                },
                {
                    "name": "Processed",
                    "caption": "Records",
                    "width": "110px"
                },
                {
                    "name": "Message",
                    "caption": "Message",
                    "width": "350px"
                }
            ],
            "values": []
        }
    ],
    "status": [
        {
            "code": 102,
            "icon": "active",
            "caption": "Instance active."
        },
        {
            "code": 201,
            "icon": "error",
            "caption": "Configuration invalid."
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "A configured variable does not exist."
        }
    ]
}
